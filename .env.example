# Copy to .env for local runs; on Render set these in the dashboard (secrets = sync:false).

# --- Frontline API (service account) ---
FRONTLINE_BASE=https://hive-frontline-backend.com
FRONTLINE_ORG_ID=            # your organization id
FRONTLINE_SVC_EMAIL=svc_analytics@britishbiologicals.com
FRONTLINE_SVC_PASSWORD=      # service-account password (read-only account)
LIFETIME_START=2026-01       # earliest month to backfill (YYYY-MM)
ETL_CONCURRENCY=8

# --- Serving / refresh ---
DATA_DIR=./data
REFRESH_EVERY_MIN=60         # background refresh cadence (0 = manual only)
FLASK_SECRET=change-me

# --- Access control ---
# Microsoft (Entra) SSO — restricts to your tenant/domain. Leave MS_CLIENT_ID empty
# to use the password gate instead.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
ALLOWED_EMAIL_DOMAIN=britishbiologicals.com
REPORT_PASSWORD=             # interim shared password (used only if MS_CLIENT_ID empty)
